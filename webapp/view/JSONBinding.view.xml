<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:form="sap.ui.layout.form" controllerName="jsonbinding.controller.JSONBinding">
    <Page id="page" title="{i18n>title}">


<content>
        <Panel xmlns="sap.m" width="auto" expandable="true" expanded="true" id="panel0" headerText="Data Binding Basics" class="sapUIResponsiveMargin">   
                <sap.ui.layout.form:SimpleForm xmlns:sap.ui.layout.form="sap.ui.layout.form" xmlns:sap.ui.core="sap.ui.core" editable="true" layout="ResponsiveGridLayout" id="form0">    
                    <sap.ui.layout.form:content>
                        <Label text="EID" id="EIDlabel"/>
                        <Input width="100%" id="EIDinput" required="false"/>
                        <Label text="Enabled" id="enablelabel"/>   
                        <CheckBox id="enableCheckbox" required="false"/>
                    </sap.ui.layout.form:content>    
                </sap.ui.layout.form:SimpleForm>
        </Panel>
        
        <Panel xmlns="sap.m" width="auto" expandable="true" expanded="true" id="panel1" headerText="Address Details" class="sapUIResponsiveMargin">   
                <sap.ui.layout.form:SimpleForm xmlns:sap.ui.layout.form="sap.ui.layout.form" xmlns:sap.ui.core="sap.ui.core" editable="true" layout="ResponsiveGridLayout" id="form1">    
                    <sap.ui.layout.form:content>
                        <Label text="Address" id="Addresslabel"/>
<Text id="textAddress" class="sapUiSmallMarginBottom" text="{/Address/Street} {/Address/Zip} {/Address/City} {/Address/Country}"/>
                        <Link id="linkEmail" href="{ path: '/EID', formatter: '.formatter.formatMail'}"/>
                        <Label text="Sales Amount" id="salesamountLabel" class="sapUiSmallMarginBegin"/>   
                        <Input id="salesamountInput" type="Number" maxLength="8" class="sapUiSmallMarginBegin" value="{ parts: [ {path: '/SalesAmount'}, {path: '/CurrencyCode'} ], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false} }"/>
                    </sap.ui.layout.form:content>    
                </sap.ui.layout.form:SimpleForm>   
                <List noDataText="Drop list items here" id="list0">   
                    <items>   
                        <StandardListItem type="Navigation" title="List Item 1" description="Description text" icon="sap-icon://picture" id="item0"/>   
                    </items>   
                </List>
        <content/>
        </Panel>
        <!-- <Panel xmlns="sap.m" width="auto" expandable="true" expanded="true" id="panel2" headerText="Aggregation Binding" class="sapUIResponsiveMargin">   
<List id= "list1">
<Title text="Product Name" id = "title1"></Title>

  </List> 

        </Panel> -->


    


</content>

    </Page>
</mvc:View>